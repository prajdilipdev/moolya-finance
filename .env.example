# Copy to .env and fill in your own values. .env is git-ignored.
# Without these the app runs fully offline (localStorage) with no login.

# Supabase project URL and publishable ("anon") key.
# Dashboard → Project Settings → API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Never put a secret key (sb_secret_... / service_role) in a VITE_ variable —
# everything prefixed with VITE_ is bundled into the client and publicly
# readable, and a secret key bypasses Row Level Security entirely.
