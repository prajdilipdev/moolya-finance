# Copy to .env and fill in your own values. .env is git-ignored.
# The app runs fully offline (localStorage) without any of these.

# Supabase — optional cloud auth + storage.
# The anon key is safe in the browser; Row Level Security is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Never put a service_role key or any private API key in a VITE_ variable —
# everything prefixed with VITE_ is bundled into the client and publicly visible.
